<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 背景播放器（全屏动态磨砂，轻模糊 + 铺满） -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/bgPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:surface_type="surface_view"
        app:use_controller="false"
        app:resize_mode="zoom"
        app:shutter_background_color="#000000"
        app:keep_content_on_player_reset="true" />

    <!-- 压暗层：约 40% 黑，保证前景清晰、背景动态人眼可辨 -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- 前景竖屏播放器（居中，9:16 竖屏，清晰主画面） -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/fgPlayerView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#000000"
        android:elevation="8dp"
        app:surface_type="surface_view"
        app:use_controller="false"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:keep_content_on_player_reset="true" />

    <!-- 顶部居中换台与状态提示，高 elevation 防止被底层遮挡 -->
    <TextView
        android:id="@+id/tipView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:background="#CC111111"
        android:elevation="40dp"
        android:paddingLeft="28dp"
        android:paddingTop="12dp"
        android:paddingRight="28dp"
        android:paddingBottom="12dp"
        android:text="正在连接直播服务..."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

</FrameLayout>
