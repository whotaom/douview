<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. 单解码双层直出动态舞台：1 个 ExoPlayer 同步绘制底层动态背景（默认清晰 ZOOM，可选 ≤5px 轻磨砂，零压暗）+ 顶层居中清晰主画面 -->
    <com.example.tv.player.AmbientVideoStageView
        android:id="@+id/videoStageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. 顶部居中换台与状态提示，高 elevation 防止被视频底层遮挡 -->
    <TextView
        android:id="@+id/tipView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:background="#CC111111"
        android:elevation="40dp"
        android:paddingLeft="28dp"
        android:paddingTop="12dp"
        android:paddingRight="28dp"
        android:paddingBottom="12dp"
        android:text="正在连接直播服务..."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

</FrameLayout>
