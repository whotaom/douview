<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090C">

    <!-- 1. 符合系统风格的固定竖屏背景图（仅竖屏直播两侧展示，横屏隐藏显纯暗底） -->
    <ImageView
        android:id="@+id/portraitBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/img_tv_portrait_backdrop"
        android:visibility="visible" />

    <!-- 2. 唯一全屏主播放器（SurfaceView 原生硬件直出 + RESIZE_MODE_FIT 完整不变形） -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        app:keep_content_on_player_reset="true"
        app:resize_mode="fit"
        app:shutter_background_color="@android:color/transparent"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- 3. 顶部居中换台与状态提示 -->
    <TextView
        android:id="@+id/tipView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:background="#CC111111"
        android:elevation="40dp"
        android:paddingLeft="28dp"
        android:paddingTop="12dp"
        android:paddingRight="28dp"
        android:paddingBottom="12dp"
        android:text="正在连接直播服务..."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

</FrameLayout>
