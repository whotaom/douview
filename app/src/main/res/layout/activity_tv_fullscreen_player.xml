<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. 竖屏视频两侧动态磨砂氛围背景（单 ExoPlayer 轻采样子帧放大，零额外解码开销） -->
    <ImageView
        android:id="@+id/ambientBgView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 2. 约 35% 暗色遮罩，保证两侧动态背景人眼可辨且不抢前景主画面 -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:visibility="gone" />

    <!-- 3. 全屏主播放器：横屏源自动铺满全屏，竖屏源居中完整呈现并透出两侧动态背景 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        app:surface_type="surface_view"
        app:use_controller="false"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:keep_content_on_player_reset="true" />

    <!-- 4. 顶部居中换台与状态提示，高 elevation 防止被视频底层遮挡 -->
    <TextView
        android:id="@+id/tipView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:background="#CC111111"
        android:elevation="40dp"
        android:paddingLeft="28dp"
        android:paddingTop="12dp"
        android:paddingRight="28dp"
        android:paddingBottom="12dp"
        android:text="正在连接直播服务..."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

</FrameLayout>
