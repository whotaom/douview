        isMenuShowing = true
        channelMenuList.removeAllViews()
        online.forEach { (realIdx, ch) ->
            val current = realIdx == currentIndex
            val tv = TextView(this).apply {
                text = (if (current) "▶ " else "   ") + ch.name
                maxLines = 1
                ellipsize = TextUtils.TruncateAt.END
                setTextColor(if (current) Color.parseColor("#4FC3F7") else Color.WHITE)
                textSize = 17f
                setPadding(18, 14, 18, 14)
                isFocusable = true
                isClickable = true
                tag = realIdx
                setOnFocusChangeListener { v, has ->
                    v.setBackgroundColor(if (has) Color.parseColor("#33FFFFFF") else Color.TRANSPARENT)
                    (v as TextView).setTextColor(
                        if (has || (v.tag as Int) == currentIndex) Color.parseColor("#4FC3F7")
                        else Color.WHITE
                    )
                }
                setOnClickListener { v ->
                    val idx = v.tag as Int
                    hideMenu()
                    switchToChannel(idx)
                }
            }
            channelMenuList.addView(tv)
        }
        channelMenu.visibility = View.VISIBLE
        val focus = online.indexOfFirst { it.first == currentIndex }.coerceAtLeast(0)
        channelMenuList.getChildAt(focus)?.requestFocus()
    }

    private fun hideMenu() {
        isMenuShowing = false
        channelMenu.visibility = View.GONE
    }

    // -------------------- OK 信息 --------------------

    private fun toggleInfo() {
        if (isInfoShowing) {
            infoOverlay.visibility = View.GONE
            isInfoShowing = false
            return
        }
        val ch = playList.getOrNull(currentIndex) ?: return
        val p = player
        val vf = p?.videoFormat
        val af = p?.audioFormat
        val br = ((p?.bitrateEstimate ?: 0).coerceAtLeast(0) / 1000)
        infoOverlay.text = buildString {
            append("频道：${ch.name}\n房间：${ch.rid}\n")
            append("状态：${if (ch.isLive) "在线" else "离线"}\n")
            append("────────────────\n")
            append("分辨率：${vf?.width ?: "-"}×${vf?.height ?: "-"}\n")
            append("视频：${vf?.sampleMimeType ?: "-"}\n")
            append("音频：${af?.sampleMimeType ?: "-"}\n")
            append("码率：${if (br > 0) "$br kbps" else "-"}\n")
            append("缓冲：${p?.totalBufferedDuration ?: 0} ms\n")
            append("────────────────\n按 OK / 返回 关闭")
        }
        infoOverlay.visibility = View.VISIBLE
        infoOverlay.bringToFront()
        isInfoShowing = true
    }

    // -------------------- 按键 / 生命周期 --------------------

    private fun handleBack() {
        when {
            isMenuShowing -> hideMenu()
            isInfoShowing -> {
                infoOverlay.visibility = View.GONE
                isInfoShowing = false
            }
            else -> {
                releaseAll()
                finish()
            }
        }
    }

    override fun onKeyDown(keyCode: Int, event: KeyEvent?): Boolean {
        if (isMenuShowing) {
            if (keyCode == KeyEvent.KEYCODE_MENU || keyCode == KeyEvent.KEYCODE_BACK ||
                keyCode == KeyEvent.KEYCODE_INFO
            ) {
                hideMenu()
                return true
            }
            return super.onKeyDown(keyCode, event)
        }
        when (keyCode) {
            KeyEvent.KEYCODE_BACK -> {
                handleBack()
                return true
            }
            KeyEvent.KEYCODE_MENU, KeyEvent.KEYCODE_INFO -> {
                showMenu()
                return true
            }
            KeyEvent.KEYCODE_DPAD_UP -> {
                if (currentIndex > 0) switchToChannel(currentIndex - 1)
                else showTip("已经是第一个频道", autoHide = true)
                return true
            }
            KeyEvent.KEYCODE_DPAD_DOWN -> {
                if (currentIndex < playList.lastIndex) switchToChannel(currentIndex + 1)
                else showTip("已经是最后一个频道", autoHide = true)
                return true
            }
            KeyEvent.KEYCODE_DPAD_CENTER, KeyEvent.KEYCODE_ENTER -> {
                toggleInfo()
                return true
            }
        }
        return super.onKeyDown(keyCode, event)
    }

    private fun showTip(msg: String, autoHide: Boolean) {
        tipView.bringToFront()
        tipView.text = msg
        tipView.visibility = View.VISIBLE
        tipView.alpha = 1f
        tipView.removeCallbacks(hideTipRunnable)
        if (autoHide) tipView.postDelayed(hideTipRunnable, 1800)
    }

    private val hideTipRunnable = Runnable {
        tipView.animate().alpha(0f).setDuration(220).withEndAction {
            tipView.visibility = View.GONE
        }.start()
    }

    private fun enterFullscreen() {
        WindowCompat.setDecorFitsSystemWindows(window, false)
        WindowInsetsControllerCompat(window, window.decorView).let {
            it.hide(WindowInsetsCompat.Type.systemBars())
            it.systemBarsBehavior =
                WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
        }
        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
    }

    private fun releasePlayerOnly() {
        bgPlayerView.player = null
        fgPlayerView.player = null
        player?.release()
        player = null
    }

    private fun releaseAll() {
        releasePlayerOnly()
        streamCache.clear()
    }

    override fun onStop() {
        super.onStop()
        player?.playWhenReady = false
    }

    override fun onStart() {
        super.onStart()
        player?.playWhenReady = true
    }

    override fun onDestroy() {
        releaseAll()
        super.onDestroy()
    }

    private fun Int.dp(): Int = (this * resources.displayMetrics.density).toInt()
}
关键参数一览（人眼可辩 + 性能）
项目	值	原因
背景模糊	14px	仍能看清轮廓与动态
压暗	#66000000（约 40%）	前景清晰，背景可辩
缓冲	10s–28s	降低 RK3528 内存与卡顿
隧道模式	关闭	减少黑屏
解码回退	开启	兼容烂盒子
单 ExoPlayer	背景+前景共用	只解一路，性能最好
换台反馈	STATE_READY / 首帧后消失	状态驱动，不误关
若仍觉得背景偏糊
只需改两处：
Kotlin
// 更清晰：模糊再降
RenderEffect.createBlurEffect(10f, 10f, Shader.TileMode.CLAMP)

// 更清晰：压暗再减
dimOverlay.setBackgroundColor(Color.parseColor("#4D000000")) // ~30%
按此实现即可同时满足：竖屏主画面、可辨认动态磨砂背景、换台正确且反馈等出画再消失、TV 性能可控。