    // -------------------- 播放与换台（修复版） --------------------

    private fun switchToChannel(index: Int) {
        if (index !in playList.indices) return
        val now = System.currentTimeMillis()
        if (now - lastSwitchAt < 450) return
        lastSwitchAt = now

        currentIndex = index
        val ch = playList[index]
        val gen = ++switchGen

        pendingTipName = ch.name
        showTip("正在切换到：${ch.name}", autoHide = false)

        player?.stop()
        player?.clearMediaItems()

        lifecycleScope.launch {
            val list = withContext(Dispatchers.IO) {
                val cached = streamCache[ch.rid]
                val t = streamCacheAt[ch.rid] ?: 0L
                if (cached != null && now - t < CACHE_TTL) cached
                else fetchQualities(ch.rid).also { if (it.isNotEmpty()) cache(ch.rid, it) }
            }
            if (gen != switchGen) return@launch

            if (list.isEmpty()) {
                pendingTipName = null
                showTip("该频道暂无法播放", autoHide = true)
                return@launch
            }
            qualityList = list
            qualityIndex = 0
            playQuality()
        }
    }

    private fun playQuality() {
        if (qualityIndex !in qualityList.indices) {
            pendingTipName = null
            showTip("播放失败", autoHide = true)
            return
        }
        val (qName, hls) = qualityList[qualityIndex]
        val chName = playList.getOrNull(currentIndex)?.name ?: ""
        if (pendingTipName != null) {
            showTip("正在切换到：$chName · $qName", autoHide = false)
        }

        releasePlayerOnly()

        val renderers = DefaultRenderersFactory(this).apply {
            setEnableDecoderFallback(true)
            setExtensionRendererMode(DefaultRenderersFactory.EXTENSION_RENDERER_MODE_PREFER)
        }
        val loadControl = DefaultLoadControl.Builder()
            .setBufferDurationsMs(10_000, 28_000, 2_000, 5_000) // TV 性能参数
            .build()
        val trackSelector = DefaultTrackSelector(this).apply {
            parameters = buildUponParameters().setTunnelingEnabled(false).build()
        }
        val dataSource = DefaultHttpDataSource.Factory()
            .setUserAgent(TV_UA)
            .setAllowCrossProtocolRedirects(true)
            .setConnectTimeoutMs(12_000)
            .setReadTimeoutMs(15_000)
        val mediaSourceFactory = DefaultMediaSourceFactory(this).setDataSourceFactory(dataSource)

        player = ExoPlayer.Builder(this, renderers)
            .setTrackSelector(trackSelector)
            .setLoadControl(loadControl)
            .setMediaSourceFactory(mediaSourceFactory)
            .build()
            .also { exo ->
                // 同一播放器驱动背景 + 前景（省一路解码，性能关键）
                bgPlayerView.player = exo
                fgPlayerView.player = exo

                exo.addListener(object : Player.Listener {
                    override fun onPlayerError(error: PlaybackException) {
                        Log.e(TAG, "error ${error.errorCodeName}: ${error.message}")
                        qualityIndex++
                        fgPlayerView.postDelayed({ playQuality() }, 900)
                    }

                    override fun onPlaybackStateChanged(state: Int) {
                        when (state) {
                            Player.STATE_BUFFERING -> {
                                if (pendingTipName != null) {
                                    showTip("正在切换到：$pendingTipName（缓冲中）", autoHide = false)
                                }
                            }
                            Player.STATE_READY -> onSwitchCompleted()
                            Player.STATE_ENDED -> showTip("直播已结束", autoHide = true)
                        }
                    }

                    override fun onRenderedFirstFrame() {
                        onSwitchCompleted()
                    }

                    override fun onVideoSizeChanged(videoSize: VideoSize) {
                        Log.d(TAG, "video ${videoSize.width}x${videoSize.height}")
                    }
                })

                exo.setMediaItem(MediaItem.fromUri(hls))
                exo.prepare()
                exo.playWhenReady = true
            }
    }

    private fun onSwitchCompleted() {
        if (pendingTipName != null) {
            val name = pendingTipName
            pendingTipName = null
            showTip("已切换到：$name", autoHide = true)
        } else {
            tipView.visibility = View.GONE
        }
    }

    private suspend fun fetchQualities(rid: String): List<Pair<String, String>> =
        withContext(Dispatchers.IO) {
            try {
                val req = Request.Builder()
                    .url("$DEFAULT_BASE_URL/live.php?rid=$rid")
                    .header("User-Agent", TV_UA)
                    .header("Referer", "$DEFAULT_BASE_URL/")
                    .get().build()
                okHttp.newCall(req).execute().use { resp ->
                    if (!resp.isSuccessful) return@withContext emptyList()
                    val body = resp.body?.string() ?: return@withContext emptyList()
                    val data = gson.fromJson(body, LiveResponse::class.java)
                    if (data.code != 200 || data.streams.isNullOrEmpty()) return@withContext emptyList()
                    val order = listOf("origin", "uhd", "hd", "sd", "ld", "default")
                    val out = mutableListOf<Pair<String, String>>()
                    for (k in order) {
                        val q = data.streams[k]
                        if (!q?.hls.isNullOrBlank()) out.add((q.name ?: k) to q.hls!!)
                    }
                    data.streams.forEach { (k, q) ->
                        if (k !in order && !q.hls.isNullOrBlank() && out.none { it.second == q.hls }) {
                            out.add((q.name ?: k) to q.hls!!)
                        }
                    }
                    out
                }
            } catch (e: Exception) {
                Log.e(TAG, "fetch", e)
                emptyList()
            }
        }

    private fun cache(rid: String, list: List<Pair<String, String>>) {
        streamCache[rid] = list
        streamCacheAt[rid] = System.currentTimeMillis()
    }

    // -------------------- 菜单（仅在线） --------------------

    private fun showMenu() {
