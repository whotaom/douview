function respond($code, $d) {
    if (ob_get_length()) {
        ob_clean();
    }
    if (!headers_sent()) {
        http_response_code(200);
        header('Content-Type: application/json; charset=utf-8');
    }
    $d['code'] = $code;
    $flags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
    if (defined('JSON_INVALID_UTF8_SUBSTITUTE')) {
        $flags |= JSON_INVALID_UTF8_SUBSTITUTE; // 远程文件含非 UTF-8 字节时不再整体编码失败
    }
    $json = json_encode($d, $flags);
    if ($json === false) {
        $json = json_encode(array('code' => 500, 'msg' => '响应编码失败，远程内容可能不是 UTF-8 文本'), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    }
    echo $json;
    exit;
}

/**
 * 批量探活专用：输出与 respond(200, array('batch' => ...)) 完全一致的 JSON，并附加 ETag。
 * 客户端携带 If-None-Match 且内容未变化时直接返回 304（无响应体），降低弱网轮询的带宽消耗。
 * Cache-Control 仅对本接口由 no-store 调整为 private, no-cache：允许浏览器保存副本，但每次必须向服务器校验。
 */
function respondBatchConditional($result) {
    $d = array('batch' => $result);
    $d['code'] = 200;
    $flags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
    if (defined('JSON_INVALID_UTF8_SUBSTITUTE')) {
        $flags |= JSON_INVALID_UTF8_SUBSTITUTE;
    }
    $json = json_encode($d, $flags);
    if ($json === false) {
        respond(200, array('batch' => $result)); // 编码失败：退回原有输出路径（含兜底），行为不变
    }

    $etag = '"' . md5($json) . '"';
    if (ob_get_length()) {
        ob_clean();
    }
    if (!headers_sent()) {
        header('Content-Type: application/json; charset=utf-8');
        header('Cache-Control: private, no-cache, must-revalidate');
        header('ETag: ' . $etag);
    }

    $inm = isset($_SERVER['HTTP_IF_NONE_MATCH']) ? trim((string)$_SERVER['HTTP_IF_NONE_MATCH']) : '';
    if ($inm !== '') {
        foreach (explode(',', $inm) as $tag) {
            $tag = trim($tag);
            if ($tag === '*') {
                http_response_code(304);
                exit;
            }
            if (strncmp($tag, 'W/', 2) === 0) {
                $tag = substr($tag, 2);
            }
            if ($tag === $etag) {
                http_response_code(304);
                exit;
            }
        }
    }

    http_response_code(200);
    echo $json;
    exit;
}

function fixUrl($u) {
    return ($u && is_string($u)) ? preg_replace('/^http:\/\//i', 'https://', trim($u)) : null;
}

function getFirstUrl($source) {
    if (is_string($source) && $source !== '') {
        return fixUrl($source);
    }
    if (is_array($source) && !empty($source)) {
        foreach ($source as $val) {
            if (is_string($val) && $val !== '') {
                return fixUrl($val);
            }
        }
    }
    return null;
}

function getCacheDir() {
    static $dir = null;
    if ($dir !== null) return $dir;

    $local = dirname(__FILE__) . '/.cache';
    if (!is_dir($local)) {
        @mkdir($local, 0755, true);
    }
    if (is_dir($local) && is_writable($local)) {
        // 禁止通过 URL 直接读取缓存文件（Apache；Nginx 请见部署说明在站点配置中 deny）。
        if (!@is_file($local . '/.htaccess')) {
            @file_put_contents($local . '/.htaccess', "<IfModule mod_authz_core.c>\nRequire all denied\n</IfModule>\n<IfModule !mod_authz_core.c>\nOrder allow,deny\nDeny from all\n</IfModule>\n");
        }
        if (!@is_file($local . '/index.html')) {
            @file_put_contents($local . '/index.html', '');
        }
        $dir = $local;
        return $dir;
    }

    $tmp = sys_get_temp_dir();
    if (@is_writable($tmp)) {
        $dir = $tmp;
        return $dir;
    }

    $dir = dirname(__FILE__);
    return $dir;
}

function cacheFile($k) {
    // 房间探活缓存使用独立前缀 dylive_r_，便于清理时无需读取内容即可区分（其余类型文件名保持不变）。
    $prefix = (strncmp($k, 'room_ok_', 8) === 0 || strncmp($k, 'room_off_', 9) === 0) ? 'dylive_r_' : 'dylive_';
    return getCacheDir() . '/' . $prefix . md5($k) . '.cache';
}

function cacheRead($k, $ttl) {
    $f = cacheFile($k);
    if (!@is_file($f)) return null;
    $mtime = @filemtime($f);
    if ($mtime === false || (time() - $mtime) >= $ttl) return null;
    $v = @file_get_contents($f);
    return ($v === false || $v === '') ? null : $v;
}

function cacheWrite($k, $v) {
    // 先写临时文件再 rename：读取方永远不会读到写了一半的 JSON。
    $f = cacheFile($k);
    $tmp = $f . '.' . getmypid() . '.' . mt_rand(100000, 999999) . '.tmp';
    if (@file_put_contents($tmp, $v, LOCK_EX) === false) {
        @unlink($tmp);
        return;
    }
    if (!@rename($tmp, $f)) {
        @unlink($tmp);
        @file_put_contents($f, $v, LOCK_EX); // 个别 Windows/旧版 PHP 下 rename 覆盖失败时的兜底
    }
}

/**
 * 缓存清理（只处理本程序的 dylive_* 文件，不触碰 .htaccess / index.html / 其他应用文件）：
 *   dylive_r_*   房间探活缓存      > CACHE_ROOM_MAX_AGE  删除
 *   *.tmp        写入遗留临时文件  > CACHE_TMP_MAX_AGE   删除
 *   其余 dylive_*                  > CACHE_OTHER_MAX_AGE 删除
 *   存活文件数 > CACHE_MAX_FILES 时，再按修改时间从旧到新删除超出部分。
 */
function cacheGcRun() {
    @ignore_user_abort(true);
    @set_time_limit(20);
    $dir = getCacheDir();
    $h = @opendir($dir);
    if (!$h) return;

    $t0 = microtime(true);
    $now = time();
    $alive = array();
    $seen = 0;
    while (($name = readdir($h)) !== false) {
        if (strncmp($name, 'dylive_', 7) !== 0 || $name === 'dylive_gc.stamp') continue;
        if (++$seen > 20000 || (microtime(true) - $t0) > CACHE_GC_BUDGET) break;

        $f = $dir . '/' . $name;
        if (!@is_file($f)) continue;
        $mt = @filemtime($f);
        if ($mt === false) continue;

        if (substr($name, -4) === '.tmp') {
            $max = CACHE_TMP_MAX_AGE;
        } elseif (strncmp($name, 'dylive_r_', 9) === 0) {
            $max = CACHE_ROOM_MAX_AGE;
        } else {
            $max = CACHE_OTHER_MAX_AGE;
        }

        if (($now - $mt) > $max) {
            @unlink($f);
        } else {
            $alive[$f] = $mt;
        }
    }
    closedir($h);

    if (count($alive) > CACHE_MAX_FILES) {
        asort($alive); // 修改时间最早的排在前面
        $excess = count($alive) - CACHE_MAX_FILES;
        foreach ($alive as $f => $mt) {
            if ($excess-- <= 0) break;
            @unlink($f);
        }
    }
}

// 按时间调度：距上次清理超过 CACHE_GC_INTERVAL 才执行；先占位再登记，避免并发请求重复清理。
// 清理放在响应送出之后（FPM 下用户无感；其他 SAPI 单次最多占用 CACHE_GC_BUDGET 秒，且每个间隔仅一次）。
function cacheGcMaybe() {
    $stamp = getCacheDir() . '/dylive_gc.stamp';
    $mt = @filemtime($stamp);
    if ($mt !== false && (time() - $mt) < CACHE_GC_INTERVAL) return;
    if (!@touch($stamp)) return; // 目录不可写：不登记，避免每个请求都尝试
    register_shutdown_function(function () {
        if (function_exists('fastcgi_finish_request')) {
            while (ob_get_level() > 0) {
                @ob_end_flush();
            }
            @fastcgi_finish_request();
        }
        cacheGcRun();
    });
}

// 命令行定时任务：php /path/to/live.php --gc （不受间隔限制，立即清理一次）
if (PHP_SAPI === 'cli') {
    global $argv;
    if (isset($argv) && is_array($argv) && in_array('--gc', $argv, true)) {
        cacheGcRun();
        echo "cache gc done\n";
        exit;
    }
} else {
    cacheGcMaybe();
}

function httpRequest($url, $headers = array(), $body = null, $withHeader = false, $ua = UA_PC) {
    if (!function_exists('curl_init')) return '';

    $ch = curl_init($url);
    $opt = array(
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_HTTPHEADER     => $headers,
        CURLOPT_HEADER         => $withHeader,
        CURLOPT_CONNECTTIMEOUT => 4,
        CURLOPT_TIMEOUT        => 8,
        CURLOPT_ENCODING       => 'gzip,deflate',
        CURLOPT_USERAGENT      => $ua,
        CURLOPT_SSL_VERIFYPEER => VERIFY_SSL,
        CURLOPT_SSL_VERIFYHOST => 2,
        CURLOPT_TCP_NODELAY    => 1,
    );
    if ($body !== null) {
        $opt[CURLOPT_POST] = true;
        $opt[CURLOPT_POSTFIELDS] = $body;
    }
    curl_setopt_array($ch, $opt);
    $res = curl_exec($ch);
    curl_close($ch);
    return is_string($res) ? $res : '';
}

