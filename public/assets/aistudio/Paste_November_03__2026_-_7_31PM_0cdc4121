function resolveDouyinShortUrl($url) {
    if (!preg_match('/^https?:\/\/v\.douyin\.com\/[A-Za-z0-9_-]+\/?$/i', $url)) {
        return null;
    }
    $cacheKey = 'surl_' . md5($url);
    $hit = cacheRead($cacheKey, TTL_SHORTURL);
    if ($hit !== null) {
        return $hit;
    }

    if (!function_exists('curl_init')) return null;

    $ch = curl_init($url);
    curl_setopt_array($ch, array(
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_HEADER         => true,
        CURLOPT_NOBODY         => true,
        CURLOPT_FOLLOWLOCATION => false,
        CURLOPT_TIMEOUT        => 5,
        CURLOPT_USERAGENT      => UA_MOBILE,
        CURLOPT_SSL_VERIFYPEER => VERIFY_SSL,
        CURLOPT_SSL_VERIFYHOST => 2,
    ));
    $headerRaw = (string)curl_exec($ch);
    curl_close($ch);

    if (preg_match('/Location:\s*([^\r\n]+)/i', $headerRaw, $lm)) {
        $loc = trim($lm[1]);
        if (preg_match('/(?:reflow\/|room_id=)(\d{15,22})/', $loc, $m)) {
            cacheWrite($cacheKey, $m[1]);
            return $m[1];
        }
        if (preg_match('/live\.douyin\.com\/(\d+)/', $loc, $m)) {
            cacheWrite($cacheKey, $m[1]);
            return $m[1];
        }
    }
    return null;
}

/* ========================================================
   军工级远程安全检测模块：防 SSRF、防重绑定、防超限 DoS
   ======================================================== */

function isPublicIp($ip) {
    if (!filter_var($ip, FILTER_VALIDATE_IP)) {
        return false;
    }
    // 过滤私有与保留地址
    $flags = FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE;
    if (filter_var($ip, FILTER_VALIDATE_IP, $flags) === false) {
        return false;
    }
    $long = ip2long($ip);
    if ($long !== false) {
        // 0.0.0.0/8
        if (($long & 0xFF000000) === 0) return false;
        // 100.64.0.0/10 (运营商级 NAT)
        if (($long & 0xFFC00000) === 0x64400000) return false;
        // 127.0.0.0/8 (环回)
        if (($long & 0xFF000000) === 0x7F000000) return false;
        // 169.254.0.0/16 (链路本地 / 云主机元数据)
        if (($long & 0xFFFF0000) === 0xA9FE0000) return false;
        // 224.0.0.0/4 (组播与广播)
        if (($long & 0xF0000000) === 0xE0000000) return false;
        if (($long & 0xF0000000) === 0xF0000000) return false;
    }
    return true;
}

function resolveRemoteRedirect($baseUrl, $location) {
    $location = trim($location);
    if ($location === '') return null;
    if (preg_match('/^https?:\/\//i', $location)) return $location;

    $base = parse_url($baseUrl);
    if (!$base || !isset($base['scheme'], $base['host'])) return null;
    $scheme = strtolower($base['scheme']);
    $host = $base['host'];
    $port = isset($base['port']) ? (int)$base['port'] : null;
    $authority = $scheme . '://' . $host;
    if ($port !== null && !(($scheme === 'http' && $port === 80) || ($scheme === 'https' && $port === 443))) {
        $authority .= ':' . $port;
    }

    if (strpos($location, '//') === 0) return $scheme . ':' . $location;
    if (isset($location[0]) && $location[0] === '/') return $authority . $location;

    $basePath = isset($base['path']) ? $base['path'] : '/';
    if (isset($location[0]) && $location[0] === '?') {
        return $authority . $basePath . $location;
    }
    $directory = preg_replace('~/[^/]*$~', '/', $basePath);
    if ($directory === null || $directory === '') $directory = '/';
    return $authority . $directory . $location;
}

function fetchRemoteSafe($url, $hop = 0) {
    if ($hop > 3) {
        respond(400, array('msg' => '重定向跳转次数过多，已终止拉取'));
    }
    if (!is_string($url) || strlen($url) > 2048 || preg_match('/[\x00-\x20\x7f]/', $url)) {
        respond(400, array('msg' => '远程链接格式非法或长度超限'));
    }

    $parsed = parse_url($url);
    if (!$parsed || !isset($parsed['scheme'], $parsed['host']) || isset($parsed['user']) || isset($parsed['pass'])) {
        respond(400, array('msg' => '非法或无法解析的远程链接'));
    }
    $scheme = strtolower($parsed['scheme']);
    if ($scheme !== 'http' && $scheme !== 'https') {
        respond(400, array('msg' => '安全策略拦截：仅支持 HTTP 与 HTTPS 协议'));
    }
    $port = isset($parsed['port']) ? (int)$parsed['port'] : ($scheme === 'https' ? 443 : 80);
    $allowedPorts = array(80, 443, 8080, 8443);
    if (!in_array($port, $allowedPorts, true)) {
        respond(400, array('msg' => '安全策略拦截：目标端口不在安全放行列表中'));
    }

    $host = trim($parsed['host'], '[]');
    if ($host === '' || preg_match('/[^a-zA-Z0-9.:-]/', $host)) {
        respond(400, array('msg' => '远程主机名格式非法'));
    }

    // 当前锁定策略使用 IPv4 CURLOPT_RESOLVE；IPv6 字面量不走未经锁定的请求。
    if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
        respond(400, array('msg' => '当前远程导入安全策略暂不支持 IPv6 字面量地址'));
    }

    if (filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
        $ipList = array($host);
    } else {
        $ipList = @gethostbynamel($host);
        $recordsAaaa = @dns_get_record($host, DNS_AAAA);
        if (is_array($recordsAaaa)) {
            foreach ($recordsAaaa as $record) {
                if (isset($record['ipv6']) && !isPublicIp($record['ipv6'])) {
                    respond(403, array('msg' => '安全策略拦截：远程主机同时解析到内网或保留 IPv6 地址'));
                }
            }
        }
        if (!$ipList) {
            $recordsA = @dns_get_record($host, DNS_A);
            if (is_array($recordsA)) {
                $ipList = array();
                foreach ($recordsA as $record) {
                    if (isset($record['ip'])) $ipList[] = $record['ip'];
                }
            }
        }
    }

    if (empty($ipList)) {
        respond(400, array('msg' => '远程主机解析失败或未提供可锁定的 IPv4 地址'));
    }

    $ipList = array_values(array_unique($ipList));
    foreach ($ipList as $ip) {
        if (!isPublicIp($ip)) {
            respond(403, array('msg' => '安全策略拦截：禁止访问内网或保留私有地址 (' . htmlspecialchars($ip, ENT_QUOTES, 'UTF-8') . ')'));
        }
    }

    if (!function_exists('curl_init')) {
        respond(503, array('msg' => '服务器未启用 PHP cURL 扩展，无法执行远程导入'));
    }

    // 非标准数字主机写法可能被不同网络栈解释为特殊 IPv4 表达式，直接拒绝。
    if (preg_match('/^[0-9.]+$/', $host) && !filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
        respond(400, array('msg' => '安全策略拦截：不支持非标准 IPv4 主机写法'));
    }

    $targetIp = $ipList[0];
    $ch = curl_init();
    $header = '';
    $headerTooLarge = false;
    $body = '';
    $tooLarge = false;
    $maxBodyBytes = 1048576;
    $opt = array(
        CURLOPT_URL            => $url,
        CURLOPT_RETURNTRANSFER => false,
        CURLOPT_HEADER         => false,
        CURLOPT_HEADERFUNCTION => function($curl, $line) use (&$header, &$headerTooLarge) {
            if (strlen($header) + strlen($line) > 65536) {
                $headerTooLarge = true;
                return 0;
            }
            $header .= $line;
            return strlen($line);
        },
        CURLOPT_WRITEFUNCTION  => function($curl, $chunk) use (&$body, &$tooLarge, $maxBodyBytes) {
            $length = strlen($chunk);
            if (strlen($body) + $length > $maxBodyBytes) {
                $tooLarge = true;
                return 0;
            }
            $body .= $chunk;
            return $length;
        },
        CURLOPT_CONNECTTIMEOUT => 3,
        CURLOPT_TIMEOUT        => 6,
        CURLOPT_PROXY          => '', // 禁止继承环境代理，避免 DNS 锁定被代理链绕过
        CURLOPT_IPRESOLVE      => CURL_IPRESOLVE_V4,
        CURLOPT_ENCODING       => '',
        CURLOPT_USERAGENT      => 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) DouyinLiveWorkbench/3.2',
        CURLOPT_SSL_VERIFYPEER => true,
        CURLOPT_SSL_VERIFYHOST => 2,
        CURLOPT_FOLLOWLOCATION => false, // 禁用盲目跳转，逐跳重新解析并锁定 DNS
    );
    // 域名请求强制固定 DNS 结果；IP 字面量已直接完成地址校验，无需 DNS 映射。
    if (!filter_var($host, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4)) {
        $opt[CURLOPT_RESOLVE] = array("{$host}:{$port}:{$targetIp}");
    }
    curl_setopt_array($ch, $opt);
    $rawResult = curl_exec($ch);
    $httpCode = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $curlError = curl_errno($ch);
    curl_close($ch);

    if ($tooLarge) {
        respond(413, array('msg' => '远程源文件体积过大（单次上限 1MB）'));
    }
    if ($headerTooLarge) {
        respond(502, array('msg' => '远程服务器响应头超出安全限制'));
    }
    if ($rawResult === false) {
        // 证书错误与网络错误均不向外暴露底层细节。
        error_log('[DouyinLiveWorkbench] Remote import cURL error: ' . $curlError);
        respond(504, array('msg' => '远程拉取失败、证书校验未通过或连接超时'));
    }

    // 受控重定向校验，每一跳都会重新执行协议、端口、DNS 与 IP 检查。
    if (in_array($httpCode, array(301, 302, 303, 307, 308), true)) {
        if (preg_match_all('/^Location:\s*([^\r\n]+)/im', $header, $matches) && !empty($matches[1])) {
            $nextUrl = resolveRemoteRedirect($url, trim(end($matches[1])));
            if (!$nextUrl) respond(400, array('msg' => '远程重定向地址无效'));
            $nextParsed = parse_url($nextUrl);
            if ($scheme === 'https' && isset($nextParsed['scheme']) && strtolower($nextParsed['scheme']) !== 'https') {
                respond(403, array('msg' => '安全策略拦截：禁止 HTTPS 重定向降级到 HTTP'));
            }
            return fetchRemoteSafe($nextUrl, $hop + 1);
        }
    }

    if ($httpCode < 200 || $httpCode >= 400) {
        respond($httpCode, array('msg' => '远程服务器响应错误，HTTP 状态码: ' . $httpCode));
    }

    respond(200, array(
        'code'   => 200,
        'source' => $url,
        'size'   => strlen($body),
        'raw'    => $body
    ));
}

