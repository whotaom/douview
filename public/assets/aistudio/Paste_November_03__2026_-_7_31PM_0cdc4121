function firstNonEmptyString($values) {
    foreach ($values as $value) {
        if (is_string($value) && trim($value) !== '') return trim($value);
        if (is_numeric($value) && (string)$value !== '0') return (string)$value;
    }
    return '';
}

function safeTextLimit($value, $limit) {
    $value = (string)$value;
    if (function_exists('mb_substr')) return mb_substr($value, 0, $limit, 'UTF-8');
    if (preg_match_all('/./us', $value, $matches)) return implode('', array_slice($matches[0], 0, $limit));
    return substr($value, 0, $limit);
}

function extractAvatarUrl($owner) {
    if (!is_array($owner)) return '';
    $avatar = isset($owner['avatar_thumb']) ? $owner['avatar_thumb'] : (isset($owner['avatar_medium']) ? $owner['avatar_medium'] : (isset($owner['avatar']) ? $owner['avatar'] : array()));
    if (is_string($avatar)) return fixUrl($avatar);
    if (is_array($avatar)) {
        if (isset($avatar['url_list']) && is_array($avatar['url_list'])) return getFirstUrl($avatar['url_list']);
        if (isset($avatar['url']) && is_string($avatar['url'])) return fixUrl($avatar['url']);
    }
    return '';
}

function extractStreamSet($room, $qualityMap) {
    if (!is_array($room)) return array();
    $streams = array();
    $su = isset($room['stream_url']) && is_array($room['stream_url']) ? $room['stream_url'] : array();
    $streamTreeRaw = isset($su['live_core_sdk_data']['pull_data']['stream_data']) ? (string)$su['live_core_sdk_data']['pull_data']['stream_data'] : '';
    $streamTree = $streamTreeRaw !== '' ? json_decode($streamTreeRaw, true) : null;
    if (is_array($streamTree) && !empty($streamTree['data'])) {
        foreach ($qualityMap as $key => $label) {
            $main = isset($streamTree['data'][$key]['main']) && is_array($streamTree['data'][$key]['main']) ? $streamTree['data'][$key]['main'] : null;
            if ($main) {
                $streams[$key] = array(
                    'name' => $label,
                    'flv' => fixUrl(isset($main['flv']) ? $main['flv'] : null),
                    'hls' => fixUrl(isset($main['hls']) ? $main['hls'] : null)
                );
            }
        }
    }
    if (empty($streams)) {
        $flvList = isset($su['flv_pull_url']) ? $su['flv_pull_url'] : null;
        $flv = isset($su['rtmp_pull_url']) ? fixUrl($su['rtmp_pull_url']) : getFirstUrl($flvList);
        $hls = isset($su['hls_pull_url']) ? fixUrl($su['hls_pull_url']) : null;
        if ($flv || $hls) {
            $streams['default'] = array('name' => '高清 (推荐)', 'flv' => $flv, 'hls' => $hls);
        }
    }
    return $streams;
}

/**
 * 从不同版本的抖音响应结构提取房间公开资料。
 * 只在上游明确返回数值 status 时认定状态已核验，网络错误/风控响应保持 unknown。
 */
function mergeRoomSnapshot($room, &$info, $qualityMap) {
    if (!is_array($room)) return false;

    $owner = array();
    foreach (array('owner', 'user', 'anchor', 'owner_info', 'user_info') as $ownerKey) {
        if (isset($room[$ownerKey]) && is_array($room[$ownerKey])) {
            $owner = $room[$ownerKey];
            break;
        }
    }

    $nickname = firstNonEmptyString(array(
        isset($owner['nickname']) ? $owner['nickname'] : '',
        isset($owner['nick_name']) ? $owner['nick_name'] : '',
        isset($owner['display_id']) ? $owner['display_id'] : '',
        isset($room['nickname']) ? $room['nickname'] : '',
        isset($room['anchor_name']) ? $room['anchor_name'] : ''
    ));
    if ($nickname !== '') $info['anchor_name'] = safeTextLimit($nickname, 50);

    $roomTitle = firstNonEmptyString(array(
        isset($room['title']) ? $room['title'] : '',
        isset($room['room_title']) ? $room['room_title'] : '',
        isset($room['live_title']) ? $room['live_title'] : ''
    ));
    if ($roomTitle !== '') $info['title'] = safeTextLimit($roomTitle, 100);

    $avatar = extractAvatarUrl($owner);
    if ($avatar !== '') $info['avatar'] = $avatar;

    if (array_key_exists('status', $room) && is_numeric($room['status'])) {
        $info['status_known'] = true;
        if ((int)$room['status'] === 2) $info['is_live'] = true;
        elseif (!$info['is_live']) $info['is_live'] = false;
    }

    if ($info['is_live']) {
        $streams = extractStreamSet($room, $qualityMap);
        if (!empty($streams)) $info['streams'] = $streams;
    }

    return ($nickname !== '' || $roomTitle !== '' || $avatar !== '' || array_key_exists('status', $room));
}

function collectRoomCandidates($payload) {
    if (!is_array($payload)) return array();
    $candidates = array();
    $paths = array(
        array('data', 'room'),
        array('data', 'data', 0),
        array('data', 'data', 0, 'room'),
        array('data', 'data', 0, 'room_info'),
        array('data', 'room_info'),
        array('data', 'data', 'room'),
        array('room'),
        array('room_info')
    );
    foreach ($paths as $path) {
        $value = $payload;
        foreach ($path as $part) {
            if (is_array($value) && array_key_exists($part, $value)) $value = $value[$part];
            else { $value = null; break; }
        }
        if (is_array($value)) $candidates[] = $value;
    }
    return $candidates;
}

function fetchRoomInfo($rid) {
    $qualityMap = array(
        'origin' => '原画 (1080P60)',
        'uhd'    => '超清 (1080P)',
        'hd'     => '高清 (720P)',
        'sd'     => '标清 (540P)'
    );
    $info = array(
        'is_live' => false,
        'status_known' => false,
        'anchor_name' => '',
        'title' => '',
        'avatar' => '',
        'streams' => array()
    );

    // 1) 优先查询 room_id 信息。即使已结束，也尝试保留 owner/title/avatar。
    if (strlen($rid) >= 15) {
        $reflowApi = 'https://webcast.amemv.com/webcast/room/reflow/info/?room_id=' . rawurlencode($rid) . '&live_id=1&app_id=1128';
        $rfRaw = httpRequest($reflowApi, array('Accept: application/json'), null, false, UA_MOBILE);
        $rfJson = json_decode($rfRaw, true);
        foreach (collectRoomCandidates($rfJson) as $roomCandidate) {
            mergeRoomSnapshot($roomCandidate, $info, $qualityMap);
        }
    }

    // 2) 若资料不完整、状态未验证或在线但缺少流地址，再走 web_rid 入口补全。
    $needWebEnter = (!$info['status_known'] || $info['anchor_name'] === '' || $info['avatar'] === '' || ($info['is_live'] && empty($info['streams'])));
    if ($needWebEnter) {
        $queryParams = array(
            'aid'              => 6383,
            'app_name'         => 'douyin_web',
            'live_id'          => 1,
            'device_platform'  => 'web',
            'language'         => 'zh-CN',
            'enter_from'       => 'web_live',
            'cookie_enabled'   => 'true',
            'screen_width'     => 1920,
            'screen_height'    => 1080,
            'browser_language' => 'zh-CN',
            'browser_platform' => 'Win32',
            'browser_name'     => 'Chrome',
            'browser_version'  => '124.0.0.0',
            'web_rid'          => $rid,
        );
        $api = 'https://live.douyin.com/webcast/room/web/enter/?' . http_build_query($queryParams);
        $headers = array(
            'Accept: application/json, text/plain, */*',
            'Accept-Language: zh-CN,zh;q=0.9',
            'Referer: https://live.douyin.com/' . $rid,
            'User-Agent: ' . UA_PC
        );
        $ttwid = getTtwid();
        if ($ttwid !== '') $headers[] = 'Cookie: ttwid=' . $ttwid;

        $raw = httpRequest($api, $headers, null, false, UA_PC);
        $data = json_decode($raw, true);
        foreach (collectRoomCandidates($data) as $roomCandidate) {
            mergeRoomSnapshot($roomCandidate, $info, $qualityMap);
        }
    }

    return $info;
}

/* ===== 路由 2：批量探活接口 ===== */
if (isset($_GET['batch'])) {
    @set_time_limit(60);
    $deadline = microtime(true) + 18; // 超过后未缓存的房间返回 unknown，由前端下一轮继续，避免触发 PHP 超时致命错误
    $rawList = explode(',', (string)$_GET['batch']);
    $result = array();
    $count = 0;
    foreach ($rawList as $item) {
        $cleanId = trim($item);
        if (!preg_match('/^\d{3,22}$/', $cleanId) || ++$count > 20) continue;

        $c = cacheRead('room_ok_' . $cleanId, TTL_LIVE);
        if ($c !== null) {
            $dec = json_decode($c, true);
            if (is_array($dec)) {
                $result[$cleanId] = array(
                    'status' => 'live',
                    'title'  => isset($dec['title']) ? $dec['title'] : '',
                    'avatar' => isset($dec['avatar']) ? $dec['avatar'] : '',
                    'name'   => isset($dec['anchor_name']) ? $dec['anchor_name'] : ''
                );
                continue;
            }
        }

        $cOff = cacheRead('room_off_' . $cleanId, TTL_OFF);
        if ($cOff !== null) {
            $decOff = json_decode($cOff, true);
            // 仅复用新版带元数据的离线缓存；旧版只有 msg 的缓存允许自然失效后重查。
            if (is_array($decOff) && isset($decOff['probe_version']) && (int)$decOff['probe_version'] >= 2) {
                $result[$cleanId] = array(
                    'status' => 'offline',
                    'title'  => isset($decOff['title']) ? $decOff['title'] : '',
                    'avatar' => isset($decOff['avatar']) ? $decOff['avatar'] : '',
                    'name'   => isset($decOff['anchor_name']) ? $decOff['anchor_name'] : ''
                );
                continue;
            }
        }

        if (microtime(true) > $deadline) {
            $result[$cleanId] = array('status' => 'unknown', 'title' => '', 'avatar' => '', 'name' => '');
            continue;
        }

        $info = fetchRoomInfo($cleanId);
        if (!empty($info['status_known'])) {
            $status = !empty($info['is_live']) ? 'live' : 'offline';
            $cachePayload = json_encode(array(
                'probe_version' => 2,
                'code' => $status === 'live' ? 200 : 404,
                'web_rid' => $cleanId,
                'anchor_name' => $info['anchor_name'],
                'title' => $info['title'],
                'avatar' => $info['avatar'],
                'streams' => $info['streams']
            ), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
            if ($status === 'live') cacheWrite('room_ok_' . $cleanId, $cachePayload);
            else cacheWrite('room_off_' . $cleanId, $cachePayload);

            $result[$cleanId] = array(
                'status' => $status,
                'title'  => $info['title'],
                'avatar' => $info['avatar'],
                'name'   => $info['anchor_name']
            );
        } else {
            // 上游超时、风控、响应结构改变时保持 unknown，前端不得据此改成离线。
            $result[$cleanId] = array(
                'status' => 'unknown',
                'title'  => isset($info['title']) ? $info['title'] : '',
                'avatar' => isset($info['avatar']) ? $info['avatar'] : '',
                'name'   => isset($info['anchor_name']) ? $info['anchor_name'] : ''
            );
        }
    }

    respondBatchConditional($result);
}

