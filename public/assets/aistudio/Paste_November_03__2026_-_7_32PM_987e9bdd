  /* ===== 输入环境识别：电脑端才显示键盘快捷键说明 ===== */
  detectDesktopInput() {
    let fine = true;
    try {
      if (typeof window.matchMedia === 'function') {
        fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      }
    } catch { fine = true; }
    const ua = navigator.userAgent || '';
    const mobileUA = /Android|iPhone|iPad|iPod|Mobile|HarmonyOS|Windows Phone|BlackBerry|Opera Mini|IEMobile/i.test(ua);
    const iPadOS = /Macintosh/i.test(ua) && (navigator.maxTouchPoints || 0) > 1;
    return fine && !mobileUA && !iPadOS;
  }

  applyInputMode() {
    const apply = () => {
      document.documentElement.setAttribute('data-input', this.detectDesktopInput() ? 'desktop' : 'touch');
    };
    apply();
    try {
      const mql = window.matchMedia('(hover: hover) and (pointer: fine)');
      if (mql.addEventListener) mql.addEventListener('change', apply);
      else if (mql.addListener) mql.addListener(apply);
    } catch {}
  }

  /* ===== 用户偏好（协议 / 清晰度）持久化 ===== */
  loadPrefs() {
    try {
      const raw = localStorage.getItem(this.prefsKey);
      const parsed = raw ? JSON.parse(raw) : null;
      if (parsed && typeof parsed === 'object') {
        if (parsed.proto === 'hls' || parsed.proto === 'flv') this.prefs.proto = parsed.proto;
        if (typeof parsed.quality === 'string' && /^[A-Za-z0-9_-]{1,20}$/.test(parsed.quality)) this.prefs.quality = parsed.quality;
      }
    } catch {}
    if (this.prefs.proto && this.protoSel) this.protoSel.value = this.prefs.proto;
  }

  savePrefs() {
    try {
      localStorage.setItem(this.prefsKey, JSON.stringify(this.prefs));
    } catch {}
  }

  /* ===== 列表排序：在线靠前 → 待核验 → 离线靠后（同级保持原有顺序，仅影响显示，不改动存储顺序） ===== */
  getSortedChannels() {
    const rank = c => (c.isLive ? 0 : (c.statusKnown === false ? 1 : 2));
    return this.channels
      .map((c, i) => ({ c, i, r: rank(c) }))
      .sort((a, b) => (a.r - b.r) || (a.i - b.i))
      .map(x => x.c);
  }

  /* ===== 取流结果短时缓存：内存 + 本地存储（跨刷新），TTL 与 live.php 对齐 ===== */
  isSafeAvatar(a) {
    return typeof a === 'string' && a.length > 0 && a.length <= 500
      && (/^https?:\/\/[^\s"'<>`]+$/i.test(a) || /^data:image\/(?:png|jpe?g|gif|webp);base64,[A-Za-z0-9+/=]+$/i.test(a));
  }

  getCachedStream(rid) {
    const hit = this.streamCache.get(rid);
    if (!hit) return null;
    if (Date.now() - hit.ts > this.streamCacheTtl) {
      this.streamCache.delete(rid);
      return null;
    }
    return hit.data;
  }

  setCachedStream(rid, data) {
    this.streamCache.set(rid, { data, ts: Date.now() });
    if (this.streamCache.size > 30) {
      const oldest = this.streamCache.keys().next().value;
      this.streamCache.delete(oldest);
    }
    this.persistStreamLayer();
  }

  dropCachedStream(rid) {
    if (this.streamCache.delete(rid)) this.persistStreamLayer();
  }

  // 从本地存储读回的数据一律重新校验，字段与协议不合规即丢弃，绝不把未校验内容交给播放器。
  sanitizeStreamData(d) {
    if (!d || typeof d !== 'object' || Number(d.code) !== 200 || !d.streams || typeof d.streams !== 'object') return null;
    const okUrl = u => typeof u === 'string' && u.length <= 2048 && /^https?:\/\/[^\s"'<>`]+$/i.test(u);
    const streams = {};
    Object.keys(d.streams).slice(0, 12).forEach(k => {
      const v = d.streams[k];
      if (!/^[A-Za-z0-9_-]{1,20}$/.test(k) || !v || typeof v !== 'object') return;
      const entry = { name: typeof v.name === 'string' ? v.name.slice(0, 40) : k };
      if (okUrl(v.flv)) entry.flv = v.flv;
      if (okUrl(v.hls)) entry.hls = v.hls;
      if (entry.flv || entry.hls) streams[k] = entry;
    });
    if (Object.keys(streams).length === 0) return null;
    return {
      code: 200,
      web_rid: String(d.web_rid || ''),
      anchor_name: typeof d.anchor_name === 'string' ? d.anchor_name.slice(0, 50) : '',
      title: typeof d.title === 'string' ? d.title.slice(0, 100) : '',
      avatar: this.isSafeAvatar(d.avatar) ? d.avatar : '',
      streams
    };
  }

  persistStreamLayer() {
    try {
      const now = Date.now();
      const items = [];
      this.streamCache.forEach((v, rid) => {
        if (now - v.ts <= this.streamCacheTtl) items.push([rid, { ts: v.ts, d: v.data }]);
      });
      const recent = items.slice(-4);
      if (recent.length === 0) localStorage.removeItem(this.streamKey);
      else localStorage.setItem(this.streamKey, JSON.stringify({ v: 1, items: recent }));
    } catch {}
  }

  loadStreamLayer() {
    try {
      const parsed = JSON.parse(localStorage.getItem(this.streamKey) || 'null');
      if (!parsed || parsed.v !== 1 || !Array.isArray(parsed.items)) return;
      const now = Date.now();
      parsed.items.slice(0, 4).forEach(it => {
        if (!Array.isArray(it) || it.length !== 2) return;
        const rid = String(it[0]);
        const ts = it[1] && Number(it[1].ts);
        if (!/^\d{3,22}$/.test(rid) || !Number.isFinite(ts) || ts > now + 5000 || now - ts > this.streamCacheTtl) return;
        const data = this.sanitizeStreamData(it[1].d);
        if (data) this.streamCache.set(rid, { data, ts });
      });
    } catch {}
  }

  /* ===== 历史标题 / 头像快照：切台即刻呈现，不依赖网络 ===== */
  snapGet(rid) {
    return this.snapMem.get(String(rid)) || null;
  }

  snapSet(rid, info) {
    rid = String(rid);
    if (!/^\d{3,22}$/.test(rid) || !info) return;
    const old = this.snapMem.get(rid) || { n: '', t: '', a: '' };
    const next = { n: old.n, t: old.t, a: old.a, ts: Date.now() };
    const n = typeof info.n === 'string' ? info.n.trim() : '';
    const t = typeof info.t === 'string' ? info.t.trim() : '';
    if (n && !this.isPlaceholderName(n, rid)) next.n = n.slice(0, 50);
    if (t && !this.isPlaceholderTitle(t)) next.t = t.slice(0, 100);
    if (this.isSafeAvatar(info.a)) next.a = info.a;
    if (next.n === old.n && next.t === old.t && next.a === old.a) return;   // 无变化：不写盘
    this.snapMem.delete(rid);
    this.snapMem.set(rid, next);
    while (this.snapMem.size > 80) this.snapMem.delete(this.snapMem.keys().next().value);
    this.scheduleSnapPersist();
  }

  snapDrop(rid) {
    if (this.snapMem.delete(String(rid))) this.scheduleSnapPersist();
  }

  scheduleSnapPersist() {
    clearTimeout(this.snapTimer);
    this.snapTimer = setTimeout(() => {
      try {
        localStorage.setItem(this.snapKey, JSON.stringify({ v: 1, items: Array.from(this.snapMem.entries()) }));
      } catch {}
    }, 800);
  }

  loadSnapshots() {
    try {
      const parsed = JSON.parse(localStorage.getItem(this.snapKey) || 'null');
      if (!parsed || parsed.v !== 1 || !Array.isArray(parsed.items)) return;
      parsed.items.slice(-80).forEach(it => {
        if (!Array.isArray(it) || it.length !== 2 || !it[1] || typeof it[1] !== 'object') return;
        const rid = String(it[0]);
        if (!/^\d{3,22}$/.test(rid)) return;
        this.snapMem.set(rid, {
          n: typeof it[1].n === 'string' ? it[1].n.slice(0, 50) : '',
          t: typeof it[1].t === 'string' ? it[1].t.slice(0, 100) : '',
          a: this.isSafeAvatar(it[1].a) ? it[1].a : '',
          ts: Number(it[1].ts) || 0
        });
      });
    } catch {}
  }

