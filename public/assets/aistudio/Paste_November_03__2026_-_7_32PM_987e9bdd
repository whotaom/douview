// 播放库按需加载：主程序启动不依赖 CDN；主源失败/超时自动切备用源。
const LIB_SOURCES = {
  Hls: [
    'https://cdn.jsdelivr.net/npm/hls.js@1.5.8/dist/hls.min.js',
    'https://unpkg.com/hls.js@1.5.8/dist/hls.min.js'
  ],
  mpegts: [
    'https://cdn.jsdelivr.net/npm/mpegts.js@1.7.3/dist/mpegts.js',
    'https://unpkg.com/mpegts.js@1.7.3/dist/mpegts.js'
  ]
};
const LIB_TIMEOUT_MS = 10000;
const libPending = {};

function loadLib(name) {
  if (window[name]) return Promise.resolve(true);
  if (libPending[name]) return libPending[name];
  const urls = LIB_SOURCES[name] || [];
  libPending[name] = (async () => {
    for (const url of urls) {
      const loaded = await new Promise(resolve => {
        let done = false;
        const finish = ok => { if (!done) { done = true; clearTimeout(timer); resolve(ok); } };
        const timer = setTimeout(() => finish(false), LIB_TIMEOUT_MS);
        const el = document.createElement('script');
        el.async = true;
        el.src = url;
        el.onload = () => finish(!!window[name]);
        el.onerror = () => finish(false);
        document.head.appendChild(el);
      });
      if (loaded || window[name]) return true;
    }
    delete libPending[name];   // 全部失败：允许之后再次尝试
    return false;
  })();
  return libPending[name];
}

