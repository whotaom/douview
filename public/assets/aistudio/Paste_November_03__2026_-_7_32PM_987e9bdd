  initStorage() {
    try {
      const raw = localStorage.getItem(this.storageKey);
      const defaults = this.getDefaultChannels();

      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed) && parsed.length > 0) {
          // 对旧版本地数据进行归一化，避免被篡改的属性进入 HTML 模板。
          let normalized = parsed.map(item => this.sanitizeChannel(item)).filter(Boolean);
          // 安全网：上次关闭时若已确认下播的一次性主播（如浏览器被系统直接结束，未触发 pagehide），此处补删。
          const before = normalized.length;
          normalized = normalized.filter(item => !this.isPurgeable(item));
          this.startupPurged = before - normalized.length;
          const existingRids = new Set(normalized.map(item => item.rid));
          const toAppend = defaults.filter(d => !existingRids.has(String(d.rid)));
          this.channels = [...normalized, ...toAppend];
        } else {
          this.channels = defaults;
        }
      } else {
        this.channels = defaults;
      }
      this.saveChannels(false);
    } catch {
      this.channels = this.getDefaultChannels();
      this.saveChannels(false);
    }
  }

  updateCount(animate = true) {
    if (!this.count) return;
    const current = String(this.channels.length);
    if (this.count.textContent !== current) {
      this.count.textContent = current;
